    PI_DAEMON_CWD=/workspace PI_DAEMON_TEMP_ROOT=/tmp TMPDIR=/tmp \
    PI_DAEMON_ALLOW_INSECURE_TRANSPORT=1 PI_DAEMON_ALLOW_PROCESS_EXEC=1
WORKDIR /workspace
USER 1000:1000
EXPOSE 8787
ENTRYPOINT ["pi"]
CMD ["--daemon"]
DOCKER
    cat >"$df_full" <<'DOCKER'
FROM node:22-bookworm-slim
ARG PI_VERSION=1.5.2
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates curl fd-find git jq less make ripgrep unzip xz-utils \
      python3 python3-venv build-essential \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION} \
    && npm cache clean --force
RUN mkdir -p /workspace /home/node/.pi && chown -R 1000:1000 /workspace /home/node
ENV HOME=/home/node TERM=xterm-256color
WORKDIR /workspace
USER 1000:1000
ENTRYPOINT ["pi"]
DOCKER
    info "wrote $df_full and $df_sandbox (standard)"
    docker_ok || die "docker required to build images"
    info "building $image_full"
    build_image "$image_full" "$df_full"
    info "building $image_sandbox"
    build_image "$image_sandbox" "$df_sandbox"

    cfg_set_default variant standard
