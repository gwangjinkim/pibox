resolve_key() {
  local provider="$1" variant
  provider_env "$provider" >/dev/null || die "unknown provider '$provider' (add it to provider_env)"
  if ! skey_has "$provider"; then
    warn "no credential registered for provider '$provider'"
    printf '  register once (hidden input, OS keyring):\n    skey set %s default\n' "$provider" >&2
    return 3
  fi
  variant="$(cfg_get "$provider" variant || true)"
  if [[ -z "$variant" ]]; then
    if skey_variants "$provider" | grep -qx default; then
      variant=default
    else
      local n; n="$(skey_variants "$provider" | wc -l | tr -d ' ')"
      if [[ "$n" == 1 ]]; then
        variant="$(skey_variants "$provider" | head -n1)"
      else
        warn "$provider has variants: $(skey_variants "$provider" | tr '\n' ' ')"
        warn "pin one with: jq '.providers[\"$provider\"].variant=\"NAME\"' $CFG"
        variant="$(skey_variants "$provider" | head -n1)"
        warn "using '$variant' for now"
      fi
    fi
    cfg_set "$provider" variant "$variant"
  fi
  cfg_set "$provider" env "$(provider_env "$provider")"
  KEY_VARIANT="$variant"
  KEY_ENV="$(provider_env "$provider")"
}

wait_daemon() {
  local name="$1" i
  for i in $(seq 1 80); do
    docker logs "$name" 2>&1 | grep -q 'daemon ready' && return 0
    sleep 0.25
  done
  docker logs "$name" >&2 2>&1 | tail -n 20
  return 1
}

free_port() {
  python3 - <<'PY'
import socket
s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()
PY
}

# Internal: runs under `skey run --env PIBOX_SECRET`.
# The key goes straight into an ephemeral 0600 auth.json and is unset before pi starts.
cmd_launch() {
  # internal: runs under `skey run --env PIBOX_SECRET`
  local provider="" model="" port="${PIBOX_PORT:-}" dir="" native=0
  local -a rest=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --native) native=1; shift ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [[ -n "$provider" && -n "$model" ]] || die "_launch: missing arguments"
  [[ -n "${PIBOX_SECRET:-}" ]] || die "_launch: PIBOX_SECRET not set"

  dir="$(prepare_agent_dir)"
  (umask 077; jq -n --arg p "$provider" --arg k "$PIBOX_SECRET" \
      '{($p): {type:"api_key", key:$k}}' >"$dir/auth.json")
  chmod 600 "$dir/auth.json"
  unset PIBOX_SECRET
  trap "rm -rf '$dir'" EXIT INT TERM

  local -a extra=()
  [[ "${PIBOX_NO_EXTENSIONS:-0}" == 1 ]] && extra+=(--no-extensions)

  if [[ "$native" == 1 ]]; then
    [[ -n "${PIBOX_CWD:-}" ]] && cd "$PIBOX_CWD"
    PI_CODING_AGENT_DIR="$dir" "${PIBOX_PI:-pi}" ${extra[@]+"${extra[@]}"} \
      --model "$model" ${rest[@]+"${rest[@]}"}
  else
    [[ -n "$port" ]] || die "_launch: missing port"
    PI_CODING_AGENT_DIR="$dir" "$SANDBOX_PI" ${extra[@]+"${extra[@]}"} \
      --remote "ws://127.0.0.1:$port/pi/workspace" --model "$model" \
      ${rest[@]+"${rest[@]}"}
  fi
}

cmd_run() {
  # uv-style: `pibox run pi ...`; the agent name is optional.
  case "${1:-}" in
    pi) shift ;;
    omp|claude|codex|dsh|opencode)
      die "pibox runs pi only; use agentbox for ${1}" ;;
  esac
  local runtime="" model="" mode="" force=0 dry=0
  local ws_mode="" session_mode="${PIBOX_SESSION_MODE:-ask}" NO_EXT=0 ROOT=0
  CLI_ATTACH=()
  local -a passthru=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --runtime) runtime="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --force) force=1; shift ;;
      --session-mode) session_mode="$2"; shift 2 ;;
      --workspace) ws_mode="$2"; shift 2 ;;
      --no-extensions) NO_EXT=1; shift ;;
      --root) ROOT=1; shift ;;
      --attach) CLI_ATTACH+=("$2"); shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) passthru+=("$1"); shift ;;
    esac
  done

  [[ -n "$model" ]] || die "--model provider/model is required"
  local provider="${model%%/*}"
  [[ "$provider" != "$model" ]] || die "use an explicit provider prefix, e.g. --model opencode-go/muse-spark-1.3-contributor"

  resolve_images
  runtime="${runtime:-$(cfg_default runtime)}"; runtime="${runtime:-docker}"
  mode="${mode:-$(cfg_default mode)}"; mode="${mode:-auto}"

  resolve_key "$provider" || exit $?
  local variant="$KEY_VARIANT" envvar="$KEY_ENV"

  if [[ "$mode" == auto ]]; then
    if project_root >/dev/null 2>&1; then
      mode=container
    else
      local help_text=""
      help_text="$("$SANDBOX_PI" --help 2>&1 || true)"
      if grep -q -- '--remote <url>' <<<"$help_text"; then
        mode=remote
      else
        mode=container
      fi
    fi
  fi

  if [[ "$mode" == remote && "$ROOT" == 1 ]]; then
    die "--root is not supported in remote mode (the daemon refuses to run as root); use --mode container"
  fi

  if [[ "$mode" == remote ]]; then
    preflight_remote || die "remote cannot load your extensions; use --mode native, --mode container (with pibox migrate), or --no-extensions"
    [[ -n "$PREFLIGHT_MODE" ]] && mode="$PREFLIGHT_MODE"
    [[ "$PREFLIGHT_NO_EXT" == 1 ]] && NO_EXT=1
  fi

  # Session choice immediately after the mode choice.
  if [[ "$dry" != 1 ]]; then
    collect_attach_args

  decide_session "$session_mode" ${passthru[@]+"${passthru[@]}"}
    case "$SESSION_CHOICE" in
      quit) exit 0 ;;
      continue) passthru=(-c ${passthru[@]+"${passthru[@]}"}); info "continuing the most recent session" ;;
      session) passthru=(--session "$SESSION_ID" ${passthru[@]+"${passthru[@]}"}); info "resuming session ${SESSION_ID:0:13}" ;;
      new) [[ "$session_mode" == ask ]] && info "starting a new session" ;;
    esac
  else
    SESSION_CHOICE=new
  fi

  if [[ "$PREFLIGHT_MIGRATE" == 1 ]]; then
    if [[ "$dry" == 1 ]]; then
      info "dry run: would run 'pibox migrate' and continue in container mode"
      mode=container
    else
      info "migrating this project (pibox migrate)"
      cmd_migrate
      mode=container
    fi
  fi

  info "model=$model provider=$provider variant=$variant env=$envvar runtime=$runtime mode=$mode"

  case "$mode" in
    auto|remote|container|native) : ;;
    *) die "--mode must be auto, remote, container, or native" ;;
  esac
  case "$runtime" in
    docker) : ;;
    lima) : ;;
    *) die "--runtime must be docker or lima" ;;
  esac

  guard_workspace "$(workspace_src)" "$force"

  local penv=""
  if [[ "$dry" != 1 ]]; then
    penv="$(ensure_project_env)"
  fi
  if [[ -n "$penv" ]]; then
    export PIBOX_BASE_DIR="$penv"
    info "using project environment $penv"
  fi

  if [[ -z "$ws_mode" ]]; then
    ws_mode="$(workspace_mode_from_manifest "$(project_root || echo "$PWD")")"
  fi
  ws_mode="${ws_mode:-mount}"
  case "$ws_mode" in
    mount) : ;;
    git)
      if [[ "$dry" == 1 ]]; then
        info "dry run: would create a git worktree under .pibox/work/"
      else
        prepare_git_worktree
        trap on_exit EXIT INT TERM
      fi
      ;;
    *) die "--workspace must be mount or git" ;;
  esac

  if [[ "$dry" == 1 ]]; then
    info "dry run; no container started, no secret read"
    dim "would start: $runtime/$mode in $(workspace_src)"
    dim "session: $SESSION_CHOICE; pi args: ${passthru[*]:-<none>}"
    return 0
  fi

  if [[ "$mode" == native ]]; then
    info "native mode: your own pi and full config; tools run on this host"
    warn "no sandbox in native mode"
    if [[ "$dry" == 1 ]]; then
      dim "would run: ${PIBOX_PI:-pi} --model $model ${passthru[*]:-}"
      return 0
    fi
    PIBOX_CWD="$(workspace_src)" skey run --no-redact "$provider" "$variant" --env PIBOX_SECRET -y -- \
      "$0" _launch --provider "$provider" --model "$model" --native \
      ${passthru[@]+"${passthru[@]}"}
    exit $?
  fi

  if [[ "$runtime" == lima ]]; then
    ensure_lima || die "VM unavailable"
    ensure_image "$IMAGE_FULL" "$DOCKER_DIR/Dockerfile" 2>/dev/null || true
    local -a tty=()
    have_tty && tty=(-it)
    local -a rootargs=()
    [[ "$ROOT" == 1 ]] && rootargs=(--user 0:0 -e HOME=/home/node)
    local sbase sessions_target store
    sbase="$(session_base)"; sessions_target="/home/node/.pi/agent/sessions"
    store="$(pnpm_store)"
    local -a envmount=()
    if [[ -n "${PIBOX_BASE_DIR:-}" ]]; then
      envmount=(-v "$PIBOX_BASE_DIR:/home/node/.pi/agent")
    fi
    envmount+=(-v "$store:/home/node/.cache/pibox/pnpm-store")
    info "running pi inside a container in VM '$LIMA_NAME'"
    warn "note: VM mode passes the credential to the guest; prefer --runtime docker for tighter key isolation"
    limactl shell "$LIMA_NAME" -- docker run --rm ${tty[@]+"${tty[@]}"} ${rootargs[@]+"${rootargs[@]}"} ${envmount[@]+"${envmount[@]}"} \
      -v "$(workspace_src):/workspace" ${ATTACH_V[@]+"${ATTACH_V[@]}"} -v "$sbase:$sessions_target" -v pibox-home:/home/node/.pi \
      "$IMAGE_FULL" --model "$model" ${passthru[@]+"${passthru[@]}"}
    return $?
  fi

  if [[ "$mode" == remote ]]; then
    docker_ok || die "docker unavailable"
    ensure_image "$IMAGE" "$DOCKER_DIR/Dockerfile.sandbox"

    local token port name dir
    token="$(openssl rand -hex 32)"
    port="$(free_port)"
    name="pibox-$$-$RANDOM"
    dir="$(mktemp -d "${TMPDIR:-/tmp}/pibox.XXXXXX")"
    chmod 700 "$dir"

    info "starting sandbox daemon on 127.0.0.1:$port"
    docker run -d --rm --name "$name" \
      --label pibox=1 --label "pibox.workspace=$(workspace_src)" \
      -e PI_DAEMON_TOKEN="$token" \
      -v "$(workspace_src):/workspace" \
      ${ATTACH_V[@]+"${ATTACH_V[@]}"} \
      -p "127.0.0.1:$port:8787" \
      "$IMAGE" >/dev/null

    PIBOX_CLEAN_CONTAINER="$name"; PIBOX_CLEAN_DIR="$dir"
    trap on_exit EXIT INT TERM
    wait_daemon "$name" || die "sandbox daemon failed to start"

    if [[ "$NO_EXT" != 1 && -f "$AGENT_DIR/settings.json" ]] && jq -e '.packages | length > 0' "$AGENT_DIR/settings.json" >/dev/null 2>&1; then
      warn "remote mode uses the sandbox pi build; extensions that import @earendil-works/* will not load"
      dim "for your exact extensions and dashboard: --mode native (runs on this host, no sandbox)"
    fi
    info "tools run in the container; key is written to an ephemeral 0600 agent dir"
    PI_REMOTE_TOKEN="$token" PIBOX_PORT="$port" PIBOX_AGENT_DIR="$dir" \
      PIBOX_NO_EXTENSIONS="${NO_EXT}" \
      skey run --no-redact "$provider" "$variant" --env PIBOX_SECRET -y -- \
      "$0" _launch --provider "$provider" --model "$model" \
      ${passthru[@]+"${passthru[@]}"}
    local rc=$?
    docker rm -f "$name" >/dev/null 2>&1 || true
    rm -rf "$dir"
    PIBOX_CLEAN_CONTAINER=""; PIBOX_CLEAN_DIR=""
    finalize_git_workspace
    trap - EXIT INT TERM
    return $rc
  fi

  # container mode: whole pi process inside the container
  docker_ok || die "docker unavailable"
  ensure_image "$IMAGE_FULL" "$DOCKER_DIR/Dockerfile"
  local sbase sessions_target store; sbase="$(session_base)"; mkdir -p "$sbase"
  sessions_target="/home/node/.pi/agent/sessions"
  store="$(pnpm_store)"; mkdir -p "$store"
  local -a envmount=()
  if [[ -n "${PIBOX_BASE_DIR:-}" ]]; then
    envmount=(-v "$PIBOX_BASE_DIR:/home/node/.pi/agent")
    sessions_target="/home/node/.pi/agent/sessions"
  fi
  envmount+=(-v "$store:/home/node/.cache/pibox/pnpm-store" -e "PIBOX_PNPM_STORE=/home/node/.cache/pibox/pnpm-store")
  local -a tty=()
  have_tty && tty=(-it)
  local -a rootargs=()
  if [[ "$ROOT" == 1 ]]; then
    rootargs=(--user 0:0 -e HOME=/home/node)
    warn "running as root inside the container; tools can install packages"
  fi
  info "running the whole pi process in the container"
  local rc=0
  skey run --no-redact "$provider" "$variant" --env "$envvar" -y -- \
    docker run --rm ${tty[@]+"${tty[@]}"} ${rootargs[@]+"${rootargs[@]}"} --label pibox=1 --init \
      --cap-drop=ALL --security-opt=no-new-privileges \
      -e "$envvar" \
      -v "$(workspace_src):/workspace" \
      ${ATTACH_V[@]+"${ATTACH_V[@]}"} \
      ${envmount[@]+"${envmount[@]}"} \
      -v "$sbase:$sessions_target" \
      -v pibox-home:/home/node/.pi \
      "$IMAGE_FULL" --model "$model" ${passthru[@]+"${passthru[@]}"} || rc=$?
  [[ "$ROOT" == 1 ]] && repair_volume_owner
  return $rc
}

cmd_vm() {
  local action="${1:-status}"
  need_cmd limactl lima || die "lima is not installed"
  case "$action" in
    status) printf '%s: %s\n' "$LIMA_NAME" "$(lima_state)" ;;
    start)
      case "$(lima_state)" in
        absent) limactl start --name="$LIMA_NAME" --tty=false template:docker-rootful ;;
        stopped) limactl start "$LIMA_NAME" ;;
        running) info "already running" ;;
      esac ;;
    stop) limactl stop "$LIMA_NAME" ;;
    delete) limactl delete "$LIMA_NAME" ;;
    shell) shift; limactl shell "$LIMA_NAME" -- "$@" ;;
    *) die "vm: use status|start|stop|delete|shell" ;;
  esac
}



# ---------- project environment (uv-style) ----------
project_root() {
  local d="$PWD"
  while :; do
    if [[ -f "$d/pibox.toml" ]]; then printf '%s' "$d"; return 0; fi
    [[ "$d" == "/" ]] && return 1
    d="$(dirname "$d")"
  done
}
manifest_path() { printf '%s/pibox.toml' "$1"; }
lock_path()     { printf '%s/pibox.lock' "$1"; }
env_path()      { printf '%s/.pibox/env' "$1"; }
pi_version()    { pi --version 2>&1 | head -n1 | sed 's/^v//'; }

toml_extensions() {
  local file="$1"
  python3 - "$file" <<'PYEOF'
import re, sys, json
try:
    text = open(sys.argv[1]).read()
except OSError:
    print("{}"); sys.exit(0)
m = re.search(r'^\[extensions\]\s*$(.*?)(?=^\[|\Z)', text, re.M | re.S)
out = {}
if m:
    for line in m.group(1).splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        mm = re.match(r'^"([^"]+)"\s*=\s*"([^"]*)"$', line)
        if mm:
            out[mm.group(1)] = mm.group(2)
print(json.dumps(out))
PYEOF
}

write_manifest() {
  local root="$1" lock="$2" ver
  ver="$(jq -r '.pi // "unknown"' "$lock")"
  {
    printf '# generated by pibox; change it with: pibox add / pibox remove\n'
    printf '[pi]\nversion = "%s"\n\n' "$ver"
    printf '[extensions]\n'
    jq -r '.extensions | to_entries | sort_by(.key)[] | "\"\(.key)\" = \"\(.value)\""' "$lock"
  } >"$(manifest_path "$root")"
}

write_lock_from_toml() {
  local root="$1" ext pi_v
  ext="$(toml_extensions "$(manifest_path "$root")")"
  pi_v="$(pi_version)"
  jq -n --arg pi "$pi_v" --argjson ext "$ext" \
    '{version:1, pi:$pi, extensions:$ext}' >"$(lock_path "$root")"
}

seed_env() {
  local root="$1" env base f d
  env="$(env_path "$root")"
  base="$env/base"
  rm -rf "$env"
  mkdir -p "$env/npm" "$base"

  if [[ -f "$AGENT_DIR/settings.json" ]]; then
    jq 'del(.packages)' "$AGENT_DIR/settings.json" >"$env/settings.json"
  else
    printf '{}\n' >"$env/settings.json"
  fi

  # interface files: copied into base/, exposed with relative links so the
  # environment still works when it is mounted into a container or VM
  for f in AGENTS.md SYSTEM.md mcp.json models-store.json; do
    if [[ -e "$AGENT_DIR/$f" ]]; then
      cp -R "$AGENT_DIR/$f" "$base/$f"
      ln -s "base/$f" "$env/$f"
    fi
  done
  for d in extensions skills rules prompt-templates themes statusline; do
    if [[ -e "$AGENT_DIR/$d" ]]; then
      cp -R "$AGENT_DIR/$d" "$base/$d"
      ln -s "base/$d" "$env/$d"
    fi
  done
  # sessions stay global; containers mount over this path
  [[ -e "$AGENT_DIR/sessions" ]] && ln -s "$AGENT_DIR/sessions" "$env/sessions"
}

spec_for() {
  local source="$1" version="$2"
  case "$version" in
    path|"") printf '%s' "$source" ;;
    *) printf '%s@%s' "$source" "$version" ;;
  esac
}

pnpm_store() {
  printf '%s' "${PIBOX_PNPM_STORE:-${XDG_CACHE_HOME:-$HOME/.cache}/pibox/pnpm-store}"
}

sync_env() {
  local root="$1" env store source version spec deps pkgs pm
  env="$(env_path "$root")"
  store="$(pnpm_store)"
  [[ -f "$(lock_path "$root")" ]] || write_lock_from_toml "$root"

  info "creating environment in $env"
  seed_env "$root"
  mkdir -p "$store"

  # npm sources are installed by the package manager as one resolution
  deps="$(jq -c '[.extensions | to_entries[] | select(.key | startswith("npm:")) | {key:(.key | sub("^npm:"; "")), value:.value}] | from_entries' "$(lock_path "$root")")"
  printf '{"name":"pibox-env","private":true,"dependencies":%s}\n' "$deps" >"$env/npm/package.json"
  printf 'auto-install-peers=false\nstrict-peer-dependencies=false\nignore-scripts=true\n' >"$env/npm/.npmrc"

  # reuse the committed lock for transitive reproducibility
  [[ -f "$root/pibox.pnpm-lock.yaml" ]] && cp "$root/pibox.pnpm-lock.yaml" "$env/npm/pnpm-lock.yaml"

  if command -v pnpm >/dev/null 2>&1; then
    pm=pnpm
    local -a flags=(--dir "$env/npm" --store-dir "$store" --reporter silent --ignore-scripts)
    if [[ "${PIBOX_OFFLINE:-0}" == 1 ]]; then flags+=(--offline); else flags+=(--prefer-offline); fi
    if [[ "${PIBOX_FROZEN:-0}" == 1 && -f "$env/npm/pnpm-lock.yaml" ]]; then flags+=(--frozen-lockfile); fi
    dim "pnpm install (store: $store)"
    pnpm install ${flags[@]+"${flags[@]}"} >/dev/null || { warn "pnpm install failed"; return 1; }
    [[ -f "$env/npm/pnpm-lock.yaml" ]] && cp "$env/npm/pnpm-lock.yaml" "$root/pibox.pnpm-lock.yaml"
  else
    pm=npm
    dim "pnpm not found; falling back to npm"
    ( cd "$env/npm" && npm install --no-audit --no-fund --prefer-offline --ignore-scripts >/dev/null ) || {
      warn "npm install failed"; return 1
    }
  fi

  # non-npm sources keep using pi's own installer
  while IFS=$'\t' read -r source version; do
    case "$source" in npm:*) continue ;; esac
    spec="$(spec_for "$source" "$version")"
    dim "install $spec"
    PI_CODING_AGENT_DIR="$env" pi install "$spec" -na >/dev/null || { warn "failed to install $spec"; return 1; }
  done < <(jq -r '.extensions | to_entries[] | [.key, .value] | @tsv' "$(lock_path "$root")")

  # settings.packages must mirror the manifest exactly
  pkgs="$(jq -c '[.extensions | to_entries[] | .key + (if .value == "path" or .value == "" then "" else "@" + .value end)]' "$(lock_path "$root")")"
  jq --argjson p "$pkgs" '.packages = $p' "$env/settings.json" >"$env/settings.json.tmp.$$" \
    && mv "$env/settings.json.tmp.$$" "$env/settings.json"

  info "environment ready ($(jq -r '.extensions | length' "$(lock_path "$root")") extensions via $pm)"
}

resolve_source_version() {
  local source="$1" name
  case "$source" in
    npm:*)
      name="${source#npm:}"
      npm view "$name" version 2>/dev/null | tail -n1
      ;;
    git:*)
      printf 'HEAD'
      ;;
    *)
      printf 'path'
      ;;
  esac
}

cmd_export() {
  local from_global=0 root env source name version pkgjson
  [[ "${1:-}" == "--global" ]] && from_global=1

  root="$(project_root || true)"
  [[ -n "$root" ]] || root="$PWD"

  if [[ "$from_global" == 1 ]]; then
    env="$AGENT_DIR"
    info "exporting global pi packages"
  elif [[ -d "$(env_path "$root")" ]]; then
    env="$(env_path "$root")"
    info "exporting project environment"
  else
    env="$AGENT_DIR"
    info "no project environment; exporting global pi packages"
  fi

  local tmp; tmp="$(mktemp)"
  printf '{"version":1,"pi":"%s","extensions":{}}\n' "$(pi_version)" >"$tmp"
  if [[ -f "$env/settings.json" ]]; then
    while IFS= read -r source; do
      [[ -n "$source" ]] || continue
      case "$source" in
        npm:*)
          name="$(printf '%s' "${source#npm:}" | sed 's/@[^@/]*$//')"
          pkgjson="$env/npm/node_modules/$name/package.json"
          if [[ -f "$pkgjson" ]]; then
            version="$(jq -r .version "$pkgjson")"
          else
            version="$(resolve_source_version "$source")"
          fi
          ;;
        *)
          version="$(printf '%s' "$source" | sed -n 's/.*@//p')"
          [[ -n "$version" ]] || version="path"
          source="$(printf '%s' "$source" | sed 's/@[^@/]*$//')"
          ;;
      esac
      jq --arg s "$source" --arg v "$version" '.extensions[$s] = $v' "$tmp" >"$tmp.2" && mv "$tmp.2" "$tmp"
    done < <(jq -r '.packages[]? // empty' "$env/settings.json" 2>/dev/null)
  fi

  mkdir -p "$root"
  mv "$tmp" "$(lock_path "$root")"
  write_manifest "$root" "$(lock_path "$root")"
  info "wrote $(manifest_path "$root") and $(lock_path "$root")"
  jq -r '.extensions | to_entries[] | "  \(.key) = \(.value)"' "$(lock_path "$root")"
}

cmd_sync() {
  local root; root="$(project_root || true)"
  [[ -n "$root" ]] || die "no pibox.toml found (run: pibox export)"
  sync_env "$root"
}

cmd_add() {
  local source="${1:-}" version="" root name
  [[ -n "$source" ]] || die "usage: pibox add <npm:pkg|git:url|./path>[@version]"
  root="$(project_root || true)"
  [[ -n "$root" ]] || root="$PWD"
  [[ -f "$(manifest_path "$root")" ]] || { cmd_export >/dev/null; }
  [[ -f "$(lock_path "$root")" ]] || write_lock_from_toml "$root"

  case "$source" in
    npm:*|git:*|./*|../*|/*) : ;;
    *) source="npm:$source" ;;
  esac
  case "$source" in
    *@*) version="${source##*@}"; source="${source%@*}" ;;
  esac
  if [[ -z "$version" ]]; then
    version="$(resolve_source_version "$source")"
    [[ -n "$version" ]] || die "cannot resolve a version for '$source'"
  fi

  jq --arg s "$source" --arg v "$version" '.extensions[$s] = $v' "$(lock_path "$root")" >"$(lock_path "$root").tmp" \
    && mv "$(lock_path "$root").tmp" "$(lock_path "$root")"
  write_manifest "$root" "$(lock_path "$root")"
  info "added $source@$version"
  sync_env "$root"
}

cmd_remove() {
  local source="${1:-}" root
  [[ -n "$source" ]] || die "usage: pibox remove <source>"
  root="$(project_root || true)"
  [[ -n "$root" ]] || die "no pibox.toml found"
  [[ -f "$(lock_path "$root")" ]] || write_lock_from_toml "$root"
  jq --arg s "$source" 'del(.extensions[$s])' "$(lock_path "$root")" >"$(lock_path "$root").tmp" \
    && mv "$(lock_path "$root").tmp" "$(lock_path "$root")"
  write_manifest "$root" "$(lock_path "$root")"
  info "removed $source"
  sync_env "$root"
}

cmd_env() {
  local action="${1:-status}" root
  root="$(project_root || true)"
  case "$action" in
    status)
      [[ -n "$root" ]] || die "no pibox.toml found in this directory tree"
      printf 'root: %s\n' "$root"
      printf 'env:  %s (%s)\n' "$(env_path "$root")" "$([[ -d "$(env_path "$root")" ]] && echo present || echo missing)"
      printf 'lock: %s\n' "$(lock_path "$root")"
      [[ -f "$(lock_path "$root")" ]] && jq -r '.extensions | to_entries[] | "  \(.key) = \(.value)"' "$(lock_path "$root")"
      ;;
    init)
      root="${root:-$PWD}"
      cmd_export
      sync_env "$root"
      ;;
    *) die "env: use status|init" ;;
  esac
}

ensure_project_env() {
  local root env
  root="$(project_root || true)"
  [[ -n "$root" ]] || return 0
  env="$(env_path "$root")"
  if [[ ! -d "$env/npm/node_modules" ]]; then
    info "project environment missing; syncing"
    sync_env "$root"
  fi
  printf '%s' "$env"
}

cmd_update() {
  local check=0 bootstrap=1 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) check=1; shift ;;
      --no-bootstrap) bootstrap=0; shift ;;
      --force) force=1; shift ;;
      *) die "update: unknown option $1" ;;
    esac
  done

  need_cmd git git || die "git is required for updates"
  local repo
  repo="${PIBOX_REPO:-$(meta_repo || true)}"
  if [[ -z "$repo" ]]; then
    die "no install metadata found; re-run install.sh from your clone once, or set PIBOX_REPO=/path/to/pibox"
  fi
  [[ -d "$repo/.git" ]] || die "'$repo' is not a git checkout (set PIBOX_REPO)"
  [[ -f "$repo/pibox" && -f "$repo/install.sh" ]] || die "'$repo' does not look like the pibox repository"

  info "repository: $repo"
  local before after
  before="$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)"

  if ! git -C "$repo" fetch --quiet 2>/dev/null; then
    die "git fetch failed (check network/remotes)"
  fi
  after="$(git -C "$repo" rev-parse --short '@{u}' 2>/dev/null || echo unknown)"

  if [[ "$check" == 1 ]]; then
    if [[ "$before" == "$after" ]]; then
      info "up to date ($before)"
    else
      info "update available: $before -> $after"
      git -C "$repo" log --oneline "$before..@{u}" 2>/dev/null | head -n 10 | while IFS= read -r l; do dim "$l"; done
      dim "apply with: pibox update"
    fi
    return 0
  fi

  if [[ "$force" != 1 && -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
    die "the checkout has local changes; commit/stash them, or re-run with --force"
  fi

  info "pulling"
  git -C "$repo" pull --ff-only >&2 || die "git pull --ff-only failed"
  after="$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  if [[ "$before" == "$after" ]]; then
    info "already at $after"
  else
    info "updated $before -> $after"
  fi

  info "refreshing the installed script"
  "$repo/install.sh" >/dev/null || die "install.sh failed"
  write_meta "$repo"

  if [[ "$bootstrap" == 1 ]]; then
    info "rebuilding images (bootstrap)"
    "$repo/pibox" bootstrap
  else
    dim "skipped bootstrap (--no-bootstrap)"
  fi

  info "done: $(~/.local/bin/pibox version 2>/dev/null || echo "$PIBOX_VERSION")"
}

cmd_help() {
  cat <<EOF
pibox $PIBOX_VERSION - pi with keys in the OS keyring, tools in a container or VM

USAGE
  pibox <command> [options]

COMMANDS
  init [--dry-run] [--register]
      Read ~/.pi/agent/auth.json and register each provider's key in the
      keyring via skey. Never prints a key.

  migrate [--dry-run] [--register] [--no-sync] [--keep-auth]
      Adopt the global pi setup into this project: every installed
      extension with its exact version, interface files (settings,
      mcp, AGENTS, SYSTEM, themes, statusline, skills, rules,
      prompts), and auth.json entries. Writes pibox.toml / pibox.lock
      and builds .pibox/env.

  bootstrap [--with LIST | --minimal | --dev | --standard]
      Build both images. Required once before the first run.

      --with LIST   Alpine + single pi binary + selected toolchains.
                    Features: python, node, go, rust, build, cli
                    Aliases:  py, js, ts, rs, cc, tools, all
                    Examples:
                      --with python
                      --with node,rust,build
                      --with python,node,go,rust,build,cli
      --minimal     synonym for --with none      (~155MB)
      --dev         synonym for --with all       (~1.6GB)
      --standard    Debian + full toolchain      (~730MB)

      pi itself is always included.

  update [--check] [--no-bootstrap] [--force]
      Git pull the clone recorded at install time, refresh
      ~/.local/bin/pibox, and rebuild the images. Alias: upgrade.

  doctor
      Dependencies, keyring contents, permissions, and plaintext-key
      warnings. Exits non-zero when a security check fails.

  run --model provider/model [options] [-- pi args]
      Resolve the provider to its environment variable, fetch the secret
      from the keyring, pick a runtime, and launch pi.

      --runtime docker|lima      where tools execute (default: docker)
      --mode remote|container|native
                                 remote = orchestrate on host, tools in
                                 container (default: auto)
                                 native = your own pi and config, no sandbox
      --no-extensions            do not load extensions (quiet sandboxed runs)
      --root                     run the container as root so tools can install
                                 packages (not available in remote mode)
      --attach host[:target][:ro|rw]
                                 mount an extra host folder (repeatable)
      --session-mode ask|continue|new
                                 ask (default) prompts when the folder has
                                 sessions; continue passes -c; new starts fresh
      --force                    allow mounting \$HOME or / as workspace
      --dry-run                  show the plan without starting anything

  vm status|start|stop|delete|shell
      Manage the Lima VM used by --runtime lima.

  export [--global]
      Snapshot installed pi packages with exact versions into
      pibox.toml and pibox.lock.

  sync
      Recreate .pibox/env from pibox.toml / pibox.lock.

  add <npm:pkg|git:url|./path>[@version]
      Resolve, record, and install an extension into .pibox/env.

  remove <source>
      Remove an extension from the manifest and environment.

  env status|init
      Inspect or create the project environment.

  work list|clean
      List or remove git workspaces under .pibox/work/.

  repair
      Fix ownership of the pibox-home volume after a --root session.

  attach add|list|remove
      Persist extra host folder mounts in ./.pibox/attach (machine-local).
      Format: host[:target][:ro|rw]   (default target /attached/<name>, ro)
      Also always mounts ~/.pibox/share at /shared (rw) for live file drops.

      pibox run also accepts --attach host[:target][:ro|rw] (repeatable).
      Docker cannot add a mount to a running container: use /shared, or
      stop and resume the session with the new attachment.

  recover [--fix]
      Diagnose leftover state after a crash: containers, temp agent dirs,
      git workspaces, incomplete environment. --fix applies safe cleanup.

  clean [--containers] [--tmp] [--work] [--env] [--all]
      Targeted cleanup. Default removes stopped containers and stale temp
      dirs; running containers need --force.

  sessions list|resume|export
      list:   sessions for this folder with timestamp, size, id
      resume: pibox sessions resume <id|latest> [--model M] [-- pi args]
      export: pibox sessions export <id|latest> [out.html]

  run also accepts --workspace mount|git. git mode creates a worktree
  from a snapshot of your dirty tree, copies untracked non-ignored
  files, excludes .gitignored files such as .env, and commits the
  result to pibox/<session> on exit.

  version
      Print the version.

  help
      Show this help.

EXAMPLES
  pibox bootstrap
  pibox init
  pibox run --model opencode-go/muse-spark-1.3-contributor
  pibox run --model anthropic/claude-sonnet-4 -p "explain this repo"
  pibox run --model opencode-go/muse-spark-1.3-contributor --session-mode new
  pibox update --check
  pibox vm status

  Everything after the known flags is passed to pi.

ENVIRONMENT
  PIBOX_CONFIG_DIR       config, images, install metadata (default ~/.config/pibox)
  PIBOX_IMAGE            sandbox image (default pibox-sandbox)
  PIBOX_IMAGE_FULL       full image (default pibox-full)
  PIBOX_SANDBOX_PI       host pi binary that supports --remote
  PIBOX_PI               pi binary for --mode native (default: pi)
  PIBOX_LIMA_NAME        Lima instance (default pibox)
  PIBOX_SESSION_MODE     default for --session-mode
  PIBOX_NO_EXTENSIONS=1  pass --no-extensions in remote mode
  PIBOX_REPO             override the clone path used by update
  PIBOX_PNPM_STORE       pnpm store (default ~/.cache/pibox/pnpm-store)
  PIBOX_OFFLINE=1        install only from the store
  PIBOX_FROZEN=1         require pnpm-lock.yaml to be up to date
EOF
}
main() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    init) cmd_init "$@" ;;
    migrate) cmd_migrate "$@" ;;
    doctor) cmd_doctor "$@" ;;
    bootstrap) cmd_bootstrap "$@" ;;
    update|upgrade) cmd_update "$@" ;;
    export) cmd_export "$@" ;;
    sync) cmd_sync "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    env) cmd_env "$@" ;;
    run) cmd_run "$@" ;;
    vm) cmd_vm "$@" ;;
    work) cmd_work "$@" ;;
    attach) cmd_attach "$@" ;;
    repair) cmd_repair "$@" ;;
    recover) cmd_recover "$@" ;;
    clean) cmd_clean "$@" ;;
    sessions) cmd_sessions "$@" ;;
    _launch) cmd_launch "$@" ;;
    version|--version|-v) echo "$PIBOX_VERSION" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command '$sub' (try: pibox help)" ;;
  esac
}

main "$@"
