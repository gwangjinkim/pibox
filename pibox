      --with) variant="alpine"; with_list="$2"; shift 2 ;;
      --minimal|--alpine) variant="alpine"; with_list="none"; shift ;;
      --dev|--all) variant="alpine"; with_list="all"; shift ;;
      --standard) variant="standard"; shift ;;
      *) die "bootstrap: unknown option $1" ;;
    esac
  done

  mkdir -p "$DOCKER_DIR"
  local image_sandbox image_full df_sandbox df_full

  if [[ "$variant" == alpine ]]; then
    local feats tag
    feats="$(normalize_features "$with_list")"
    tag="$(tag_for_features "$feats")"
    image_sandbox="pibox-sandbox-$tag"
    image_full="pibox-full-$tag"
    df_sandbox="$DOCKER_DIR/Dockerfile.sandbox.$tag"
    df_full="$DOCKER_DIR/Dockerfile.$tag"

